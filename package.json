{
  "name": "yugioh-card",
  "private": true,
  "version": "1.0.0",
  "description": "游戏王卡片 Canvas 渲染工具，支持可视化表单编辑与桌面应用打包",
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite --mode electron",
    "dev:node": "vite-node --watch src/server.js",
    "play": "vite --open /play/index.html",
    "build": "vite build",
    "build:electron": "vite build --mode electron",
    "build:lib": "vite build --mode lib",
    "build:exe": "pnpm build:electron && set ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/&& electron-builder",
    "preview": "vite preview",
    "test": "node --test",
    "publish": "pnpm publish dist --registry https://registry.npmjs.org",
    "lint": "eslint",
    "lint-fix": "eslint --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kooriookami/yugioh-card"
  },
  "keywords": [
    "yugioh-card",
    "yugioh",
    "rush-duel",
    "ygo",
    "leafer",
    "canvas"
  ],
  "author": "kooriookami",
  "license": "ISC",
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@leafer/node": "^2.0.4",
    "css-line-break": "^2.1.0",
    "element-plus": "^2.13.6",
    "json-editor-vue": "^0.18.1",
    "leafer": "^2.0.4",
    "leafer-unified": "^1.0.3",
    "lodash": "^4.17.23",
    "lodash-es": "^4.17.23",
    "lodash-unified": "^1.0.3",
    "normalize.css": "^8.0.1",
    "skia-canvas": "^2.0.2",
    "vue": "^3.5.30",
    "yugioh-card": "file:packages",
    "yugioh-card-v190": "npm:yugioh-card@1.9.2"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "agent-browser": "^0.31.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^10.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "playwright": "^1.62.1",
    "sass-embedded": "^1.98.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.2",
    "vite-node": "^6.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-static-copy": "^4.0.0"
  },
  "engines": {
    "node": ">= 22"
  },
  "pnpm": {
    "allowBuilds": [
      "skia-canvas"
    ]
  },
  "build": {
    "appId": "com.yugioh.card-maker",
    "productName": "游戏王卡片生成器",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "2052",
      "unicode": true,
      "deleteAppDataOnUninstall": true
    }
  }
}
