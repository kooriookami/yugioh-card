{
  "name": "yugioh-card",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vitepress dev docs",
    "dev:node": "vite-node --watch src/server.js",
    "play": "pnpm test:pages --open /play/index.html",
    "test:pages": "vite --config test-pages/vite.config.js",
    "build": "vitepress build docs",
    "build:lib": "pnpm typecheck && vite build --mode lib",
    "preview": "vitepress preview docs",
    "typecheck": "tsc --project packages/tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test",
    "publish": "pnpm publish dist --registry https://registry.npmjs.org --tag beta",
    "lint": "eslint",
    "lint-fix": "eslint --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kooriookami/yugioh-card"
  },
  "keywords": [
    "yugioh-card",
    "yugioh",
    "rush-duel",
    "ygo",
    "leafer",
    "canvas"
  ],
  "author": "kooriookami",
  "license": "MIT",
  "dependencies": {
    "@leafer-ui/interface": "^2.3.4",
    "@leafer/node": "^2.3.4",
    "css-line-break": "^2.1.0",
    "element-plus": "^2.14.8",
    "fontkit": "^3.0.0",
    "json-editor-vue": "^0.19.2",
    "leafer": "^2.3.4",
    "leafer-unified": "^1.0.3",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "lodash-unified": "^1.0.3",
    "normalize.css": "^8.0.1",
    "skia-canvas": "^4.0.1",
    "vue": "^3.5.45",
    "yugioh-card": "file:packages"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@types/node": "26.6.6",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10.15.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "sass-embedded": "^1.108.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vitepress": "2.0.0-alpha.21"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
