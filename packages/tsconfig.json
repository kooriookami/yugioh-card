{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "."
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "**/__tests__/**"
  ]
}
